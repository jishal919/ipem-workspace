# Copy this file to .env and set values for the integrations you enable.
# Generate a unique random secret for every deployment; never reuse the example value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: absolute project root. Defaults to the IPEM repository root.
# PROJECTS_PATH=

# Frontend origins allowed to call the API (comma-separated if multiple).
FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=

# Email verification (Gmail account + app password).
# SMTP_USER=
# SMTP_PASS=

# Google sign-in.
# GOOGLE_CLIENT_ID=

# AI workflow and health checks.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/ipem-chat
N8N_HEALTH_URL=http://localhost:5678/webhook/health
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_PORT=4000
# OLLAMA_BASE_URL=http://localhost:11434

# Optional session metadata and container execution.
REDIS_HOST=localhost
REDIS_PORT=6379
USE_DOCKER=false

# Public backend URL used when building links to previews.
PUBLIC_BACKEND_URL=http://localhost:9000
